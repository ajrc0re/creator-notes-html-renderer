{
  "name": "creator-notes-html-renderer",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "build": "bun run build:backend && bun run build:frontend",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3",
    "lumiverse-spindle-types": "0.4.74",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  }
}
